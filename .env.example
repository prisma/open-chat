# Copy this file to `.env`. It holds the app's own secrets — the values
# `envSecret(...)` bindings in module.ts read at deploy time. Local dev
# (`bun run dev`) needs none of these: it provisions its own database and
# streams stand-in and generates placeholders (export a real
# OPENROUTER_API_KEY to exercise chat generation).
#
# Everything else the app needs — the database URL, the streams URL and
# bearer key, the app's own public origin, the listen port — is resolved
# and injected by the Composer deploy; none of it is configured here.
#
# Do not commit real secrets.

OPENROUTER_API_KEY=sk-or-v1-your-key
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Stripe. The webhook secret enables /api/billing/webhook so payments
# credit even if the user never returns from checkout.
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Social sign-in (optional). Each provider appears on the auth screen only
# when its credentials are set. Callback URLs:
# <app-origin>/api/auth/callback/github and /google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
